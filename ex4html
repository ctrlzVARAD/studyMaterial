<!-- index.html -->

<!DOCTYPE html>
<html>
<head>
    <title>CSS Types Example</title>

    <!-- External CSS -->
    <link rel="stylesheet" href="style.css">

    <!-- Internal CSS -->
    <style>

        h2{
            color: blue;
            text-align: center;
            text-decoration: underline;
        }

        table{
            width: 60%;
            margin: auto;
            border-collapse: collapse;
            background-color: white;
        }

        th{
            background-color: darkblue;
            color: white;
            padding: 10px;
        }

        td{
            text-align: center;
            padding: 10px;
        }

    </style>

</head>

<body>

    <!-- Inline CSS -->
    <h1 style="color:red; text-align:center;">
        Welcome to CSS Styling
    </h1>

    <h2>Student Details</h2>

    <table border="1">

        <tr>
            <th>Name</th>
            <th>Course</th>
            <th>Marks</th>
        </tr>

        <tr>
            <td>Varad</td>
            <td>BCA</td>
            <td>90</td>
        </tr>

        <tr>
            <td>Rahul</td>
            <td>BSc</td>
            <td>85</td>
        </tr>

    </table>

</body>
</html>
