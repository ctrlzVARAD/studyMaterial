/* External CSS */

body{
    background-color: lightgray;
    font-family: Arial, sans-serif;
    margin: 20px;
}

h1{
    background-color: yellow;
    padding: 15px;
    border-radius: 10px;
}

table{
    box-shadow: 2px 2px 10px gray;
}

tr:nth-child(even){
    background-color: #f2f2f2;
}

tr:hover{
    background-color: lightblue;
}
